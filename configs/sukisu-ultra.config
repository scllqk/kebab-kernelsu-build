CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_HAVE_SYSCALL_TRACEPOINTS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
CONFIG_KSU_MANUAL_SU=y
CONFIG_KPM=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set


# SUSFS - kernel-level hiding (from bmbxwbh sufs variant)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SAFE_SECURITY_FILESYSTEM=y
# CONFIG_KSU_SUSFS_SUS_PATH is not set
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
